/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * OpenThread CoAP Server overlay for XIAO nRF54L15
 * Enables IEEE 802.15.4 radio support required for OpenThread
 */

/ {
	chosen {
		zephyr,ieee802154 = &ieee802154;
	};

	/* Override expansion board button with onboard button */
	aliases {
		sw0 = &usr_btn;
	};
};

/* Fix LED polarity - hardware is actually active-low (cathode to GPIO) */
&led0 {
	gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
};

&radio {
	status = "okay";
};

&ieee802154 {
	status = "okay";
};

&temp {
	status = "okay";
};
