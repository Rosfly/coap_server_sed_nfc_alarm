/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * OpenThread CoAP Server overlay for XIAO nRF54L15
 * Enables IEEE 802.15.4 radio support required for OpenThread
 */

/ {
	chosen {
		zephyr,ieee802154 = &ieee802154;
	};

	/* Override expansion board button with onboard button */
	aliases {
		sw0 = &usr_btn;
	};

	/* Alarm output pin - weak-high pulse via internal pull-up on LED ON */
	alarm_out {
		compatible = "gpio-leds";
		alarm_pin: alarm_pin_0 {
			gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;  /* P1.06 */
			label = "Alarm Output";
		};
	};

	/* Battery voltage measurement via voltage divider
	 * Schematic: VBAT -> TPS22916C -> R5(10K) -> ADC -> R6(10K) -> GND
	 * Divider ratio: 2.0 (full_ohms / output_ohms = 20K / 10K)
	 * Battery voltage = ADC reading * 2.0
	 */
	vbat: vbat {
		compatible = "voltage-divider";
		io-channels = <&adc 7>;    /* AIN7 - P1.14 */
		output-ohms = <10000>;     /* R6 - 10K bottom resistor */
		full-ohms = <20000>;       /* R5 + R6 - 20K total */
		power-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>; /* P1.15 - TPS22916C enable */
	};
};

/* Fix LED polarity - hardware is actually active-low (cathode to GPIO) */
&led0 {
	gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
};

&radio {
	status = "okay";
};

&ieee802154 {
	status = "okay";
};

&temp {
	status = "okay";
};

/* NFC Type 4 Tag peripheral for Thread commissioning via phone */
&nfct {
	status = "okay";
};

/* ADC configuration for battery voltage measurement */
&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN7>; /* P1.14 */
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;  /* 4x oversampling for noise reduction */
	};
};
